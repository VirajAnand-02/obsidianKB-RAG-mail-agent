# # ==========================================================================
# # Obsi-Relay - environment configuration
# # Copy to `.env` and fill in. Anything left blank is optional.
# # Values here are DEFAULTS; most RAG/grounding knobs can also be overridden
# # at runtime from the admin dashboard (Settings -> `app_settings` table).
# # ==========================================================================

# # ---------------------------------------------------------------- APP -----
# NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=Obsi-Relay
# # Protects /api/cron/*. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# CRON_SECRET=
# # 32-byte base64 key encrypting provider API keys pasted into the admin UI.
# # Generate with: openssl rand -base64 32
# SETTINGS_ENCRYPTION_KEY=

# # ----------------------------------------------------------- SUPABASE -----
# # Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL=

# # Browser key. Newer projects call this the "publishable key" (sb_publishable_...);
# # older ones call it the "anon key" (a long JWT). Set whichever your dashboard
# # shows - both names are accepted.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# # NEXT_PUBLIC_SUPABASE_ANON_KEY=

# # Server-only key, bypasses row level security. Never expose to the browser.
# # Newer projects: "secret key" (sb_secret_...). Older: "service_role" JWT.
# SUPABASE_SECRET_KEY=
# # SUPABASE_SERVICE_ROLE_KEY=

# # Direct Postgres connection used by scripts/db/* for migrations and seeding.
# # Project Settings -> Database -> Connection string -> URI.
# #
# # Paste the password exactly as generated. Supabase passwords often contain
# # @ # ? / : & which are structural characters in a URI; they are percent-encoded
# # automatically, so no manual escaping is needed. Do not wrap the value in quotes.
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# # Storage bucket holding uploaded vault archives and raw note bodies.
# SUPABASE_STORAGE_BUCKET=vaults

# # --------------------------------------------------------------- AUTH -----
# # Comma-separated allowlist. Only these addresses may sign in to the dashboard.
# ADMIN_EMAILS=you@yourdomain.com

# # ==========================================================================
# # LLM GENERATION (Vercel AI SDK - provider independent)
# # Set the default here; admins can switch provider/model in the dashboard.
# # ==========================================================================
# # One of: openai | anthropic | google | mistral | groq | deepseek | xai |
# #         cohere | azure | openrouter | ollama | openai-compatible
# LLM_PROVIDER=mistral
# LLM_MODEL=mistral-large-latest
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=2000
# LLM_REQUEST_TIMEOUT_MS=60000

# # --- Provider credentials (fill in only what you use) ---
# OPENAI_API_KEY=
# # Only set this to override the OpenAI endpoint. Leave commented out otherwise.
# # OPENAI_BASE_URL=

# ANTHROPIC_API_KEY=

# # Google AI Studio key - generous free tier for both chat and embeddings.
# GOOGLE_GENERATIVE_AI_API_KEY=

# # Mistral - free tier available for chat and `mistral-embed`.
# MISTRAL_API_KEY=

# # Groq - free tier, very fast inference for open-weight models.
# GROQ_API_KEY=

# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=
# OPENROUTER_API_KEY=

# AZURE_API_KEY=
# AZURE_RESOURCE_NAME=
# AZURE_API_VERSION=2024-10-21

# # Local models via Ollama - free, no API key required.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# # Any OpenAI-compatible endpoint (vLLM, LM Studio, Together, Fireworks...).
# OPENAI_COMPATIBLE_NAME=custom
# # OPENAI_COMPATIBLE_BASE_URL=
# # OPENAI_COMPATIBLE_API_KEY=

# # ==========================================================================
# # EMBEDDINGS
# # EMBEDDING_DIMENSIONS must match the model. Vectors live in per-dimension
# # tables, so changing the model means a re-embed (npm run db:reembed),
# # not a schema migration.
# # ==========================================================================
# # Free-tier friendly: mistral | google | ollama | jina | huggingface | cohere
# # Also supported:     openai | voyage | openai-compatible
# EMBEDDING_PROVIDER=mistral
# EMBEDDING_MODEL=mistral-embed
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_CONCURRENCY=3
# # Prefixes for asymmetric models (e5 / bge / nomic style). Leave blank otherwise.
# EMBEDDING_DOC_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# # Free-tier embedding providers reached over plain HTTP (no SDK needed):
# JINA_API_KEY=
# HUGGINGFACE_API_KEY=
# VOYAGE_API_KEY=
# # Ollama embeddings, fully local and free:
# #   EMBEDDING_PROVIDER=ollama, EMBEDDING_MODEL=nomic-embed-text, dims 768

# # ==========================================================================
# # CHUNKING (defaults tuned for Obsidian markdown)
# # ==========================================================================
# # markdown = split on heading structure first, then pack to size. recursive = plain.
# CHUNK_STRATEGY=markdown
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64
# CHUNK_MIN_TOKENS=48
# CHUNK_MAX_TOKENS=1024
# # Prepend "Note title > H1 > H2" breadcrumb to each chunk. Big retrieval win.
# CHUNK_PREPEND_HEADINGS=true
# # Never split inside fenced code blocks or markdown tables.
# CHUNK_KEEP_CODE_BLOCKS=true

# # ==========================================================================
# # RETRIEVAL
# # ==========================================================================
# # Hybrid = pgvector similarity + Postgres full-text, fused with RRF.
# RAG_HYBRID=true
# RAG_RRF_K=60
# # Candidates pulled per retriever before fusion and reranking.
# RAG_CANDIDATE_K=40
# # Chunks that actually reach the prompt.
# RAG_TOP_K=8
# RAG_MIN_SCORE=0.2
# # Pull N chunks either side of each hit to restore context. 0 disables.
# RAG_NEIGHBOR_WINDOW=1
# # Rewrite the question into several variants before retrieving.
# RAG_QUERY_EXPANSION=true
# RAG_QUERY_VARIANTS=3
# # Optional cross-encoder rerank. Providers: cohere | jina | none
# RAG_RERANKER=none
# RAG_RERANKER_MODEL=rerank-v3.5
# # Hard token budget for the assembled context block.
# RAG_CONTEXT_TOKEN_BUDGET=6000
# # pgvector HNSW tuning (m/ef_construction applied by migrations, ef_search per query).
# PGVECTOR_HNSW_M=16
# PGVECTOR_HNSW_EF_CONSTRUCTION=64
# PGVECTOR_HNSW_EF_SEARCH=100

# # ==========================================================================
# # VAULT INGESTION
# # ==========================================================================
# MAX_VAULT_UPLOAD_MB=200
# INGEST_CONCURRENCY=6
# # Comma-separated globs skipped during ingest.
# INGEST_EXCLUDE_GLOBS=.obsidian/**,.trash/**,.git/**,**/node_modules/**,**/*.excalidraw.md
# # Honour `publish: false` / `private: true` frontmatter and private tags.
# INGEST_RESPECT_PRIVACY_FRONTMATTER=true
# INGEST_PRIVATE_TAGS=private,secret,noindex

# # ==========================================================================
# # EMAIL - Resend
# # ==========================================================================
# RESEND_API_KEY=
# # Must be a verified domain in Resend.
# RESEND_FROM_EMAIL=relay@yourdomain.com
# RESEND_FROM_NAME=Obsi-Relay
# RESEND_REPLY_TO=ask@yourdomain.com
# # Inbound: point this subdomain MX at Resend, webhook -> /api/inbound/resend
# RESEND_INBOUND_DOMAIN=ask.yourdomain.com
# # Svix signing secret from Resend webhook settings. Required in production.
# RESEND_WEBHOOK_SECRET=
# # Newsletter audience id (Resend -> Audiences). Optional; local list works too.
# RESEND_AUDIENCE_ID=
# # When true, emails are rendered and logged but never actually sent.
# MAIL_DRY_RUN=true
# # Only accept inbound questions from these domains. Blank = allow all.
# ALLOWED_SENDER_DOMAINS=
# RATE_LIMIT_REPLIES_PER_SENDER_PER_DAY=10

# # ==========================================================================
# # GROUNDING GATE (send / review / block)
# # ==========================================================================
# GROUNDING_ENABLED=true
# # Leave blank to reuse LLM_PROVIDER / LLM_MODEL for the grounding judge.
# GROUNDING_PROVIDER=
# GROUNDING_MODEL=
# # score >= autosend -> send automatically
# # score >= review   -> queue for human review in the dashboard
# # score <  review   -> blocked; sender gets a "not in knowledge base" reply
# GROUNDING_AUTOSEND_THRESHOLD=0.8
# GROUNDING_REVIEW_THRESHOLD=0.5
# # Require every factual claim to map to a retrieved chunk.
# GROUNDING_REQUIRE_CITATIONS=true
# # Fail closed: if the grounding call itself errors, route to human review.
# GROUNDING_FAIL_MODE=review

# # ==========================================================================
# # NEWSLETTER SCHEDULING
# # ==========================================================================
# NEWSLETTER_ENABLED=false
# NEWSLETTER_CRON=0 9 * * MON
# NEWSLETTER_TIMEZONE=Asia/Kolkata
# # How far back to look for new/changed notes when composing an issue.
# NEWSLETTER_LOOKBACK_DAYS=7
# NEWSLETTER_MAX_ITEMS=6
# # Newsletters pass through the grounding gate as well.
# NEWSLETTER_REQUIRE_APPROVAL=true

# # ==========================================================================
# # EVALUATOR (src/evaluator)
# # ==========================================================================
# # Leave blank to reuse the default LLM provider/model as judge.
# EVAL_JUDGE_PROVIDER=
# EVAL_JUDGE_MODEL=
# EVAL_DATASET=src/evaluator/datasets/golden.jsonl
# EVAL_OUTPUT_DIR=eval-results
# EVAL_CONCURRENCY=4
# # Run each case N times to measure variance.
# EVAL_REPEATS=1
# # CI gate: an overall score below this fails `npm run eval`.
# EVAL_PASS_THRESHOLD=0.7

# # -------------------------------------------------------- OBSERVABILITY ---
# LOG_LEVEL=info
