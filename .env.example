# Secrets and deployment credentials only. Non-secret defaults live in
# src/lib/app-config.ts.

SETTINGS_ENCRYPTION_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MISTRAL_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Public demo. When true the sign-in is removed entirely and every visitor gets
# full admin access: uploading vaults, settings, provider keys, and approving a
# draft in the review queue — which sends a real email.
#
# Unlike DEV_AUTH_BYPASS this DOES apply in production and on Vercel. That is the
# point (a reviewer has to be able to reach it), and also why it defaults to off.
# Turn it off when the demo window closes.
DEMO_MODE=false
